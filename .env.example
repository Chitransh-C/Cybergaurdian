# CyberGuardian Environment Configuration Template
PORT=5000
VITE_API_URL=http://localhost:5000/api

# Database Connection
DATABASE_URL="mysql://root:password@127.0.0.1:3306/cyberguardian"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=cyberguardian

# Security
JWT_SECRET=your_jwt_secret_key
NODE_ENV=development

# GuardianAI tutor (optional — local Socratic tutor is used if blank)
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
